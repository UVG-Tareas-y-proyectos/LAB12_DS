{
  "name": "Observatorio",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "es-ES",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "tables": [
      {
        "name": "Calendario",
        "columns": [
          {
            "name": "fecha",
            "dataType": "dateTime",
            "sourceColumn": "fecha",
            "summarizeBy": "none",
            "formatString": "yyyy-mm"
          },
          {
            "name": "anio",
            "dataType": "int64",
            "sourceColumn": "anio",
            "summarizeBy": "none"
          },
          {
            "name": "trimestre_num",
            "dataType": "int64",
            "sourceColumn": "trimestre",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "mes_num",
            "dataType": "int64",
            "sourceColumn": "mes",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "periodo",
            "dataType": "string",
            "sourceColumn": "periodo",
            "summarizeBy": "none"
          },
          {
            "name": "Mes",
            "dataType": "string",
            "sourceColumn": "Mes",
            "summarizeBy": "none",
            "sortByColumn": "mes_num"
          },
          {
            "name": "Trimestre",
            "dataType": "string",
            "sourceColumn": "Trimestre",
            "summarizeBy": "none",
            "sortByColumn": "trimestre_num"
          }
        ],
        "partitions": [
          {
            "name": "Calendario",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Fuente = Csv.Document(File.Contents(RutaDatos & \"/calendario.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Encabezados = Table.PromoteHeaders(Fuente, [PromoteAllScalars=true]),",
                "    Tipos = Table.TransformColumnTypes(Encabezados, {{\"fecha\", type date}, {\"anio\", Int64.Type}, {\"trimestre\", Int64.Type}, {\"mes\", Int64.Type}, {\"periodo\", type text}}, \"en-US\"),",
                "    NombreMes = Table.AddColumn(Tipos, \"Mes\", each {\"Ene\",\"Feb\",\"Mar\",\"Abr\",\"May\",\"Jun\",\"Jul\",\"Ago\",\"Sep\",\"Oct\",\"Nov\",\"Dic\"}{[mes] - 1}, type text),",
                "    NombreTrimestre = Table.AddColumn(NombreMes, \"Trimestre\", each \"T\" & Text.From([trimestre]), type text)",
                "in",
                "    NombreTrimestre"
              ]
            }
          }
        ],
        "hierarchies": [
          {
            "name": "Jerarquía de periodo",
            "levels": [
              {
                "name": "Año",
                "ordinal": 0,
                "column": "anio"
              },
              {
                "name": "Trimestre",
                "ordinal": 1,
                "column": "Trimestre"
              },
              {
                "name": "Mes",
                "ordinal": 2,
                "column": "Mes"
              }
            ]
          }
        ],
        "measures": [
          {
            "name": "Selección activa",
            "expression": "VAR Anios = IF(ISFILTERED(Calendario[anio]), CONCATENATEX(VALUES(Calendario[anio]), Calendario[anio], \", \", Calendario[anio], ASC), \"todos los años\")\nVAR Meses = IF(ISFILTERED(Calendario[Mes]) || ISFILTERED(Calendario[mes_num]) || ISFILTERED(Calendario[Trimestre]), CONCATENATEX(SUMMARIZE(Calendario, Calendario[mes_num], Calendario[Mes]), Calendario[Mes], \", \", Calendario[mes_num], ASC), \"todos los meses\")\nVAR ViasSel = IF(ISFILTERED(Vias[via]), CONCATENATEX(VALUES(Vias[via]), Vias[via], \", \", Vias[via], ASC), \"todas las vías\")\nRETURN \"Consulta activa: \" & Anios & \" · \" & Meses & \" · \" & ViasSel"
          }
        ]
      },
      {
        "name": "Vias",
        "columns": [
          {
            "name": "via",
            "dataType": "string",
            "sourceColumn": "via",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Vias",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Fuente = Table.FromRecords({[via = \"Aérea\"], [via = \"Marítima\"], [via = \"Terrestre\"]}, type table [via = text])",
                "in",
                "    Fuente"
              ]
            }
          }
        ]
      },
      {
        "name": "Flujo",
        "columns": [
          {
            "name": "fecha",
            "dataType": "dateTime",
            "sourceColumn": "fecha",
            "summarizeBy": "none"
          },
          {
            "name": "via",
            "dataType": "string",
            "sourceColumn": "via",
            "summarizeBy": "none"
          },
          {
            "name": "viajeros",
            "dataType": "double",
            "sourceColumn": "viajeros",
            "summarizeBy": "sum",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "Flujo",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Fuente = Csv.Document(File.Contents(RutaDatos & \"/flujo.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Encabezados = Table.PromoteHeaders(Fuente, [PromoteAllScalars=true]),",
                "    Tipos = Table.TransformColumnTypes(Encabezados, {{\"fecha\", type date}, {\"via\", type text}, {\"viajeros\", type number}}, \"en-US\")",
                "in",
                "    Tipos"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Ingresos",
            "expression": "SUM(Flujo[viajeros])",
            "formatString": "#,0"
          },
          {
            "name": "Participacion terrestre",
            "expression": "DIVIDE(CALCULATE([Ingresos], Vias[via] = \"Terrestre\"), CALCULATE([Ingresos], REMOVEFILTERS(Vias)))",
            "formatString": "0.00%"
          },
          {
            "name": "Meses con registro",
            "expression": "CALCULATE(DISTINCTCOUNT(Flujo[fecha]), REMOVEFILTERS(Vias))",
            "formatString": "0"
          },
          {
            "name": "Aviso exploración",
            "expression": "IF(ISBLANK([Ingresos]) || [Ingresos] = 0, \"No hay ingresos registrados para esta selección. Amplíe los años, meses o vías, o use Limpiar filtros.\", \"\")"
          }
        ]
      },
      {
        "name": "Region",
        "columns": [
          {
            "name": "Región",
            "dataType": "string",
            "sourceColumn": "Región",
            "summarizeBy": "none"
          },
          {
            "name": "Grupo regional",
            "dataType": "string",
            "sourceColumn": "Grupo regional",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Region",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Fuente = Csv.Document(File.Contents(RutaDatos & \"/regiones.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Encabezados = Table.PromoteHeaders(Fuente, [PromoteAllScalars=true]),",
                "    Tipos = Table.TransformColumnTypes(Encabezados, {{\"fecha\", type date}, {\"Región\", type text}, {\"viajeros\", type number}}, \"en-US\"),",
                "    Totales = Table.Group(Tipos, {\"Región\"}, {{\"Total\", each List.Sum([viajeros]), type number}}),",
                "    Orden = Table.Sort(Totales, {{\"Total\", Order.Descending}}),",
                "    Mayores = List.FirstN(Orden[Región], 4),",
                "    Grupo = Table.AddColumn(Orden, \"Grupo regional\", each if List.Contains(Mayores, [Región]) then Text.Proper([Región]) else \"Otras regiones\", type text),",
                "    Resultado = Table.SelectColumns(Grupo, {\"Región\", \"Grupo regional\"})",
                "in",
                "    Resultado"
              ]
            }
          }
        ]
      },
      {
        "name": "Regiones",
        "columns": [
          {
            "name": "fecha",
            "dataType": "dateTime",
            "sourceColumn": "fecha",
            "summarizeBy": "none"
          },
          {
            "name": "Región",
            "dataType": "string",
            "sourceColumn": "Región",
            "summarizeBy": "none"
          },
          {
            "name": "viajeros",
            "dataType": "double",
            "sourceColumn": "viajeros",
            "summarizeBy": "sum",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "Regiones",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Fuente = Csv.Document(File.Contents(RutaDatos & \"/regiones.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Encabezados = Table.PromoteHeaders(Fuente, [PromoteAllScalars=true]),",
                "    Tipos = Table.TransformColumnTypes(Encabezados, {{\"fecha\", type date}, {\"Región\", type text}, {\"viajeros\", type number}}, \"en-US\")",
                "in",
                "    Tipos"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Ingresos por región",
            "expression": "SUM(Regiones[viajeros])",
            "formatString": "#,0"
          }
        ]
      },
      {
        "name": "Mercados",
        "columns": [
          {
            "name": "fecha",
            "dataType": "dateTime",
            "sourceColumn": "fecha",
            "summarizeBy": "none"
          },
          {
            "name": "Región",
            "dataType": "string",
            "sourceColumn": "Región",
            "summarizeBy": "none"
          },
          {
            "name": "País",
            "dataType": "string",
            "sourceColumn": "País",
            "summarizeBy": "none"
          },
          {
            "name": "viajeros",
            "dataType": "double",
            "sourceColumn": "viajeros",
            "summarizeBy": "sum",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "Mercados",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Fuente = Csv.Document(File.Contents(RutaDatos & \"/mercados.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Encabezados = Table.PromoteHeaders(Fuente, [PromoteAllScalars=true]),",
                "    Tipos = Table.TransformColumnTypes(Encabezados, {{\"fecha\", type date}, {\"Región\", type text}, {\"País\", type text}, {\"viajeros\", type number}}, \"en-US\")",
                "in",
                "    Tipos"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Ingresos por país",
            "expression": "SUM(Mercados[viajeros])",
            "formatString": "#,0"
          },
          {
            "name": "Aviso países",
            "expression": "IF(ISBLANK([Ingresos por país]), \"La región elegida no tiene registros por país en este periodo.\", \"\")"
          }
        ]
      },
      {
        "name": "Fronteras",
        "columns": [
          {
            "name": "fecha",
            "dataType": "dateTime",
            "sourceColumn": "fecha",
            "summarizeBy": "none"
          },
          {
            "name": "via",
            "dataType": "string",
            "sourceColumn": "via",
            "summarizeBy": "none"
          },
          {
            "name": "Frontera",
            "dataType": "string",
            "sourceColumn": "Frontera",
            "summarizeBy": "none"
          },
          {
            "name": "viajeros",
            "dataType": "double",
            "sourceColumn": "viajeros",
            "summarizeBy": "sum",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "Fronteras",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Fuente = Csv.Document(File.Contents(RutaDatos & \"/fronteras.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Encabezados = Table.PromoteHeaders(Fuente, [PromoteAllScalars=true]),",
                "    Tipos = Table.TransformColumnTypes(Encabezados, {{\"fecha\", type date}, {\"Vía\", type text}, {\"Frontera\", type text}, {\"viajeros\", type number}}, \"en-US\"),",
                "    Renombrar = Table.RenameColumns(Tipos, {{\"Vía\", \"via\"}})",
                "in",
                "    Renombrar"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Ingresos por frontera",
            "expression": "SUM(Fronteras[viajeros])",
            "formatString": "#,0"
          },
          {
            "name": "Aviso fronteras",
            "expression": "IF(ISBLANK([Ingresos por frontera]) || [Ingresos por frontera] = 0, \"No hay flujo registrado para esta vía y periodo. Desde 2017 el detalle marítimo es limitado.\", \"\")"
          }
        ]
      },
      {
        "name": "IndiceEstacional",
        "columns": [
          {
            "name": "mes_num",
            "dataType": "int64",
            "sourceColumn": "mes",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Mes",
            "dataType": "string",
            "sourceColumn": "Mes",
            "summarizeBy": "none",
            "sortByColumn": "mes_num"
          },
          {
            "name": "indice_estacional",
            "dataType": "double",
            "sourceColumn": "indice_estacional",
            "summarizeBy": "sum",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "IndiceEstacional",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Fuente = Csv.Document(File.Contents(RutaDatos & \"/indice_estacional.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Encabezados = Table.PromoteHeaders(Fuente, [PromoteAllScalars=true]),",
                "    Tipos = Table.TransformColumnTypes(Encabezados, {{\"mes\", Int64.Type}, {\"indice_estacional\", type number}}, \"en-US\"),",
                "    NombreMes = Table.AddColumn(Tipos, \"Mes\", each {\"Ene\",\"Feb\",\"Mar\",\"Abr\",\"May\",\"Jun\",\"Jul\",\"Ago\",\"Sep\",\"Oct\",\"Nov\",\"Dic\"}{[mes] - 1}, type text)",
                "in",
                "    NombreMes"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Índice estacional",
            "expression": "SUM(IndiceEstacional[indice_estacional])",
            "formatString": "0.0"
          },
          {
            "name": "Referencia anual",
            "expression": "IF(NOT ISEMPTY(IndiceEstacional), 100)",
            "formatString": "0"
          }
        ]
      },
      {
        "name": "Metricas",
        "columns": [
          {
            "name": "modelo_id",
            "dataType": "string",
            "sourceColumn": "modelo_id",
            "summarizeBy": "none"
          },
          {
            "name": "modelo",
            "dataType": "string",
            "sourceColumn": "modelo",
            "summarizeBy": "none"
          },
          {
            "name": "MAE base",
            "dataType": "double",
            "sourceColumn": "mae",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "RMSE base",
            "dataType": "double",
            "sourceColumn": "rmse",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "serie",
            "dataType": "string",
            "sourceColumn": "serie",
            "summarizeBy": "none"
          },
          {
            "name": "evaluacion",
            "dataType": "string",
            "sourceColumn": "evaluacion",
            "summarizeBy": "none"
          },
          {
            "name": "Tipo de modelo",
            "dataType": "string",
            "sourceColumn": "Tipo de modelo",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Metricas",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Fuente = Csv.Document(File.Contents(RutaDatos & \"/metricas_modelos.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Encabezados = Table.PromoteHeaders(Fuente, [PromoteAllScalars=true]),",
                "    Tipos = Table.TransformColumnTypes(Encabezados, {{\"modelo_id\", type text}, {\"modelo\", type text}, {\"mae\", type number}, {\"rmse\", type number}, {\"serie\", type text}, {\"evaluacion\", type text}}, \"en-US\"),",
                "    Tipo = Table.AddColumn(Tipos, \"Tipo de modelo\", each if List.Contains({\"Suavizamiento exponencial simple\", \"Holt-Winters aditivo\", \"Seasonal naive\"}, [modelo]) then \"Simple de referencia\" else \"Otro modelo del Lab 1\", type text)",
                "in",
                "    Tipo"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "MAE",
            "expression": "SELECTEDVALUE(Metricas[MAE base])",
            "formatString": "#,0"
          },
          {
            "name": "RMSE",
            "expression": "SELECTEDVALUE(Metricas[RMSE base])",
            "formatString": "#,0"
          },
          {
            "name": "Menor RMSE seleccionado",
            "expression": "VAR Mejor = TOPN(1, VALUES(Metricas[modelo]), CALCULATE(MIN(Metricas[RMSE base])), ASC)\nRETURN IF(ISEMPTY(Metricas), \"Seleccione al menos un modelo.\", \"Menor RMSE entre los seleccionados: \" & CONCATENATEX(Mejor, Metricas[modelo], \", \") & \" (\" & FORMAT(CALCULATE(MIN(Metricas[RMSE base])), \"#,0\") & \" visitantes)\")"
          }
        ]
      },
      {
        "name": "MetricasLSTM",
        "columns": [
          {
            "name": "clave",
            "dataType": "string",
            "sourceColumn": "clave",
            "summarizeBy": "none"
          },
          {
            "name": "serie",
            "dataType": "string",
            "sourceColumn": "serie",
            "summarizeBy": "none"
          },
          {
            "name": "configuracion",
            "dataType": "string",
            "sourceColumn": "configuracion",
            "summarizeBy": "none"
          },
          {
            "name": "arquitectura",
            "dataType": "string",
            "sourceColumn": "arquitectura",
            "summarizeBy": "none"
          },
          {
            "name": "ventana",
            "dataType": "int64",
            "sourceColumn": "ventana",
            "summarizeBy": "none"
          },
          {
            "name": "MAE LSTM",
            "dataType": "double",
            "sourceColumn": "mae_test",
            "summarizeBy": "none"
          },
          {
            "name": "RMSE LSTM",
            "dataType": "double",
            "sourceColumn": "rmse_test",
            "summarizeBy": "none"
          },
          {
            "name": "sMAPE %",
            "dataType": "double",
            "sourceColumn": "smape_test",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "MetricasLSTM",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Fuente = Csv.Document(File.Contents(RutaDatos & \"/metricas_lstm.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Encabezados = Table.PromoteHeaders(Fuente, [PromoteAllScalars=true]),",
                "    Tipos = Table.TransformColumnTypes(Encabezados, {{\"clave\", type text}, {\"serie\", type text}, {\"configuracion\", type text}, {\"arquitectura\", type text}, {\"ventana\", Int64.Type}, {\"mae_test\", type number}, {\"rmse_test\", type number}, {\"smape_test\", type number}}, \"en-US\")",
                "in",
                "    Tipos"
              ]
            }
          }
        ]
      },
      {
        "name": "Predicciones",
        "columns": [
          {
            "name": "clave",
            "dataType": "string",
            "sourceColumn": "clave",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "serie",
            "dataType": "string",
            "sourceColumn": "serie",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "fecha",
            "dataType": "dateTime",
            "sourceColumn": "fecha",
            "summarizeBy": "none",
            "formatString": "yyyy-mm"
          },
          {
            "name": "real",
            "dataType": "double",
            "sourceColumn": "real",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "prediccion",
            "dataType": "double",
            "sourceColumn": "prediccion",
            "summarizeBy": "none",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "Predicciones",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Fuente = Csv.Document(File.Contents(RutaDatos & \"/predicciones_lstm.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Encabezados = Table.PromoteHeaders(Fuente, [PromoteAllScalars=true]),",
                "    Tipos = Table.TransformColumnTypes(Encabezados, {{\"clave\", type text}, {\"serie\", type text}, {\"fecha\", type date}, {\"real\", type number}, {\"prediccion\", type number}}, \"en-US\")",
                "in",
                "    Tipos"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Observado",
            "expression": "VAR Serie = SELECTEDVALUE(MetricasLSTM[clave], \"total_viajeros\") RETURN CALCULATE(SUM(Predicciones[real]), KEEPFILTERS(Predicciones[clave] = Serie))",
            "formatString": "#,0"
          },
          {
            "name": "Estimado LSTM",
            "expression": "VAR Serie = SELECTEDVALUE(MetricasLSTM[clave], \"total_viajeros\") RETURN CALCULATE(SUM(Predicciones[prediccion]), KEEPFILTERS(Predicciones[clave] = Serie))",
            "formatString": "#,0"
          },
          {
            "name": "Error absoluto LSTM",
            "expression": "VAR Serie = SELECTEDVALUE(MetricasLSTM[clave], \"total_viajeros\") RETURN CALCULATE(SUMX(Predicciones, ABS(Predicciones[real] - Predicciones[prediccion])), KEEPFILTERS(Predicciones[clave] = Serie))",
            "formatString": "#,0"
          },
          {
            "name": "Serie LSTM consultada",
            "expression": "VAR Serie = SELECTEDVALUE(MetricasLSTM[serie], \"Total mensual de viajeros\") RETURN \"Serie consultada: \" & Serie & \". Evaluación histórica abril 2021 a junio 2026.\""
          }
        ]
      }
    ],
    "expressions": [
      {
        "name": "RutaDatos",
        "kind": "m",
        "expression": "\"C:/Users/mdax8/Desktop/UVG/8 Semestre/Data Science/Lab 12/LAB12_DS/data/processed\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
      }
    ],
    "relationships": [
      {
        "name": "d57b57cf-98e0-56d6-b3f5-e48060f30b37",
        "fromTable": "Flujo",
        "fromColumn": "fecha",
        "toTable": "Calendario",
        "toColumn": "fecha",
        "fromCardinality": "many",
        "toCardinality": "one",
        "crossFilteringBehavior": "oneDirection"
